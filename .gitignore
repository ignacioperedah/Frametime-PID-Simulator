# Godot 4+ specific ignores
.godot/
/android/

# Export builds (Web / Windows Desktop / etc.)
# Solo en la raíz: el nombre del binario sigue el nombre del proyecto
# y puede volver a cambiar. No afecta a futuros assets en subcarpetas.
/*.exe
/*.pck
/*.wasm
/*.wasm.map
/*.html
/*.js
/*.png
/*.png.import
# Excepción: captura usada en el README (no es output de build)
!/Screen.png
/build/
/export/
/Exportacion/

# IDE / editor
.vscode/
.idea/

# OS / temp
*.tmp
mono_crash.*
