# Godot 4+ specific ignores
.godot/
/android/

# Export builds (Web / Windows Desktop / etc.)
# Solo en la raíz: el nombre del binario sigue el nombre del proyecto
# y puede volver a cambiar. No afecta a futuros assets en subcarpetas.
/*.exe
/*.pck
/*.wasm
/*.wasm.map
/*.html
/*.js
/*.png
/*.png.import
/build/
/export/
/Exportacion/

# Caché de import de Godot para material que no es un asset de juego
# (capturas de pantalla en docs/), se regenera solo al abrir el editor.
/docs/*.import

# IDE / editor
.vscode/
.idea/

# OS / temp
*.tmp
mono_crash.*
